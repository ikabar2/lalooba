# Copy this file to .env.local and fill in your actual values.
# Get these from your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key is used ONLY server-side (Edge Functions, never the app).
# Set this in the Supabase dashboard under Edge Functions > Secrets, not here.
# SUPABASE_SERVICE_ROLE_KEY=never-put-this-in-NEXT_PUBLIC- or client code
